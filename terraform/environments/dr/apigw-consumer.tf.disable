module "apigw_consumer" {
  source = "../../modules/apigw"
  
  api_name        = var.apigw_consumer_name
  api_description = "Clone from consumer-api-gateway"
  stage_name      = var.apigw_consumer_stage_name
  region          = data.aws_region.current.name
  
  minimum_compression_size = 0
  
  stage_variables = {
    apiDns = var.stage_var_api_dns
  }
  tags = {
    STAGE = var.apigw_consumer_tag
  }
  
  authorizer_name          = var.consumer_com_api_auth_name
  authorizer_type          = "COGNITO_USER_POOLS"
  authorizer_provider_arns = [aws_cognito_user_pool.consumer_cognito.arn]
  
  xray_tracing_enabled = true # for apigw_consumer stage
  
  resources = [
    # Level 1 resources
    {
      key       = "que_app"
      parent_key = "root"
      path_part = "que_app"
    },
    {
      key       = "meme_cloud_api"
      parent_key = "root"
      path_part = "meme-cloud-api"
    },
    {
      key       = "lambda"
      parent_key = "root"
      path_part = "lambda"
    },
    {
      key       = "providers"
      parent_key = "root"
      path_part = "providers"
    },
    {
      key       = "user"
      parent_key = "root"
      path_part = "user"
    },
    {
      key       = "item"
      parent_key = "root"
      path_part = "item"
    },
    {
      key       = "case_resource"
      parent_key = "root"
      path_part = "case"
    },
    {
      key       = "consts"
      parent_key = "root"
      path_part = "consts"
    },
    {
      key       = "notifications"
      parent_key = "root"
      path_part = "notifications"
    },
    {
      key       = "analytics"
      parent_key = "root"
      path_part = "analytics"
    },
    {
      key       = "webhooks"
      parent_key = "root"
      path_part = "webhooks"
    },
    {
      key       = "opt_ins_options"
      parent_key = "root"
      path_part = "opt-ins-options"
    },
    {
      key       = "articles"
      parent_key = "root"
      path_part = "articles"
    },
    {
      key       = "feedback"
      parent_key = "root"
      path_part = "feedback"
    },
    {
      key       = "get_init_analysis"
      parent_key = "root"
      path_part = "get-init-analysis"
    },
    {
      key       = "check_access_code"
      parent_key = "root"
      path_part = "check-access-code"
    },
    {
      key       = "send_result_to_email"
      parent_key = "root"
      path_part = "send-result-to-email"
    },
    {
      key       = "get_result_pdf"
      parent_key = "root"
      path_part = "get-result-pdf"
    },
    {
      key       = "download_que_app_result_pdf"
      parent_key = "root"
      path_part = "download-que_app-result-pdf"
    },
    {
      key       = "contact_us"
      parent_key = "root"
      path_part = "contact-us"
    },
    {
      key       = "init"
      parent_key = "root"
      path_part = "init"
    },
    {
      key       = "accept_tos"
      parent_key = "root"
      path_part = "accept-tos"
    },
    {
      key       = "verify_recaptcha"
      parent_key = "root"
      path_part = "verify-recaptcha"
    },
    {
      key       = "admin"
      parent_key = "root"
      path_part = "admin"
    },
    {
      key       = "v1"
      parent_key = "root"
      path_part = "v1"
    },
    # Level 2 resources
    {
      key       = "que_app_form"
      parent_key = "que_app"
      path_part = "form"
    },
    {
      key       = "que_app_result"
      parent_key = "que_app"
      path_part = "result"
    },
    {
      key       = "que_app_assessment_request_token"
      parent_key = "que_app"
      path_part = "assessment-request-token"
    },
    {
      key       = "que_app_create_mock"
      parent_key = "que_app"
      path_part = "create-mock"
    },
    {
      key       = "que_app_partial"
      parent_key = "que_app"
      path_part = "partial"
    },
    {
      key       = "que_app_status"
      parent_key = "que_app"
      path_part = "status"
    },
    {
      key       = "que_app_update"
      parent_key = "que_app"
      path_part = "update"
    },
    {
      key       = "meme_cloud_api_library"
      parent_key = "meme_cloud_api"
      path_part = "library"
    },
    {
      key       = "lambda_cases"
      parent_key = "lambda"
      path_part = "cases"
    },
    {
      key       = "providers_insurance"
      parent_key = "providers"
      path_part = "insurance"
    },
    {
      key       = "providers_listing"
      parent_key = "providers"
      path_part = "listing"
    },
    {
      key       = "providers_premium_listing"
      parent_key = "providers"
      path_part = "premium-listing"
    },
    {
      key       = "providers_details"
      parent_key = "providers"
      path_part = "details"
    },
    {
      key       = "providers_zipcode"
      parent_key = "providers"
      path_part = "zipcode"
    },
    {
      key       = "providers_display_get_help"
      parent_key = "providers"
      path_part = "display-get-help"
    },
    {
      key       = "providers_genetic_test_form"
      parent_key = "providers"
      path_part = "genetic-test-form"
    },
    {
      key       = "providers_connect"
      parent_key = "providers"
      path_part = "connect"
    },
    {
      key       = "providers_category"
      parent_key = "providers"
      path_part = "category"
    },
    {
      key       = "providers_leads"
      parent_key = "providers"
      path_part = "leads"
    },
    {
      key       = "user_contact"
      parent_key = "user"
      path_part = "contact"
    },
    {
      key       = "user_forms"
      parent_key = "user"
      path_part = "forms"
    },
    {
      key       = "user_verify_token"
      parent_key = "user"
      path_part = "verify-token"
    },
    {
      key       = "user_pusher_auth"
      parent_key = "user"
      path_part = "pusher-auth"
    },
    {
      key       = "user_pusher_visitor_auth"
      parent_key = "user"
      path_part = "pusher-visitor-auth"
    },
    {
      key       = "user_phone"
      parent_key = "user"
      path_part = "phone"
    },
    {
      key       = "item_save"
      parent_key = "item"
      path_part = "save"
    },
    {
      key       = "item_get_all"
      parent_key = "item"
      path_part = "get-all"
    },
    {
      key       = "item_detail"
      parent_key = "item"
      path_part = "detail"
    },
    {
      key       = "item_result"
      parent_key = "item"
      path_part = "result"
    },
    {
      key       = "item_validation_update"
      parent_key = "item"
      path_part = "validation-update"
    },
    {
      key       = "item_re_validate"
      parent_key = "item"
      path_part = "re-validate"
    },
    {
      key       = "item_result_breakdown"
      parent_key = "item"
      path_part = "result-breakdown"
    },
    {
      key       = "item_upload_new_item"
      parent_key = "item"
      path_part = "upload-new-item"
    },
    {
      key       = "case_appointments"
      parent_key = "case_resource"
      path_part = "appointments"
    },
    {
      key       = "case_dscore"
      parent_key = "case_resource"
      path_part = "dscore"
    },
    {
      key       = "case_zipcode"
      parent_key = "case_resource"
      path_part = "zipcode"
    },
    {
      key       = "consts_user_consts"
      parent_key = "consts"
      path_part = "user-consts"
    },
    {
      key       = "consts_user_level_consts"
      parent_key = "consts"
      path_part = "user-level-consts"
    },
    {
      key       = "notifications_sms"
      parent_key = "notifications"
      path_part = "sms"
    },
    {
      key       = "analytics_send"
      parent_key = "analytics"
      path_part = "send"
    },
    {
      key       = "webhooks_typeform"
      parent_key = "webhooks"
      path_part = "typeform"
    },
    {
      key       = "admin_campaigns"
      parent_key = "admin"
      path_part = "campaigns"
    },
    {
      key       = "admin_templates"
      parent_key = "admin"
      path_part = "templates"
    },
    {
      key       = "v1_que_app"
      parent_key = "v1"
      path_part = "que_app"
    },
    # Level 3 resources
    {
      key       = "que_app_form_start_submission"
      parent_key = "que_app_form"
      path_part = "start-submission"
    },
    {
      key       = "que_app_form_collect_answers"
      parent_key = "que_app_form"
      path_part = "collect-answers"
    },
    {
      key       = "meme_cloud_api_library_search"
      parent_key = "meme_cloud_api_library"
      path_part = "search"
    },
    {
      key       = "meme_cloud_api_library_browse"
