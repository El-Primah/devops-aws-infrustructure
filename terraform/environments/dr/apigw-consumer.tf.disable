        integration_http_method = "GET"
        passthrough_behavior    = "WHEN_NO_MATCH"
      }
    },
    {
      key          = "meme_cloud_api_library_browse_get"
      resource_key = "meme_cloud_api_library_browse"
      http_method  = "GET"
      authorization = "NONE"
      integration = {
        type                    = "HTTP_PROXY"
        uri                     = "https://$${stageVariables.apiDns}/meme-cloud-api/library/browse"
        integration_http_method = "GET"
        passthrough_behavior    = "WHEN_NO_MATCH"
      }
    },
    {
