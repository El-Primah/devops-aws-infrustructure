        passthrough_behavior    = "WHEN_NO_MATCH"
      }
    },
    # Lambda methods
    {
      key          = "lambda_cases_any"
      resource_key = "lambda_cases"
      http_method  = "ANY"
      authorization = "NONE"
      integration = {
        type                    = "AWS_PROXY"
        uri                     = "arn:aws:apigateway:${data.aws_region.current.name}:lambda:path/2015-03-31/functions/arn:aws:lambda:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:function:bm-get-cases/invocations"
        integration_http_method = "POST"
        passthrough_behavior    = "WHEN_NO_MATCH"
      }
    },
    # Providers methods
    {
      key          = "providers_insurance_get"
      resource_key = "providers_insurance"
      http_method  = "GET"
      authorization = "COGNITO_USER_POOLS"
      authorizer_id = module.apigw_consumer.authorizer_id
      integration = {
        type                    = "HTTP_PROXY"
        uri                     = "https://$${stageVariables.apiDns}/providers/insurance"
