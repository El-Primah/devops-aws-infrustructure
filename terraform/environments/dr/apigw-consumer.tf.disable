      http_method  = "GET"
      authorization = "NONE"
      integration = {
        type                    = "HTTP_PROXY"
        uri                     = "https://$${stageVariables.apiDns}/providers/genetic-test-form"
        integration_http_method = "GET"
        passthrough_behavior    = "WHEN_NO_MATCH"
      }
    },
    {
      key          = "providers_connect_post"
      resource_key = "providers_connect"
      http_method  = "POST"
      authorization = "COGNITO_USER_POOLS"
      authorizer_id = module.apigw_consumer.authorizer_id
      integration = {
        type                    = "HTTP_PROXY"
        uri                     = "https://$${stageVariables.apiDns}/providers/connect"
