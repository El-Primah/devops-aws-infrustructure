      resource_key = "meme_cloud_api_library_search_features"
      http_method  = "GET"
      authorization = "NONE"
      integration = {
        type                    = "HTTP_PROXY"
        uri                     = "https://$${stageVariables.apiDns}/meme-cloud-api/library/search/features"
        integration_http_method = "GET"
        passthrough_behavior    = "WHEN_NO_MATCH"
      }
    },
    {
      key          = "meme_cloud_api_library_search_memes_get"
      resource_key = "meme_cloud_api_library_search_memes"
