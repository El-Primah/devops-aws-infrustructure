            "kubectl $KCTL scale deployment/meme-cloud                   --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/meme-gateway                 --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/labs                         --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/library-api                  --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/comp-que_app                 --replicas=$REPLICA_COUNT -n dfg",
