            "kubectl $KCTL scale deployment/research                     --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/resource                     --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/shepherd                     --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/web-client                   --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/eck-kibana-kb                --replicas=$REPLICA_COUNT -n elk",
            "kubectl $KCTL scale deployment/kube-prmthus-grafana                       --replicas=$REPLICA_COUNT -n monitoring",
