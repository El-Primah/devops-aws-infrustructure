{
    "Parameters": {
        "commands": [
            "#!/bin/bash",
            "export KCTL=\"--kubeconfig=/root/.kube/config\"",
            "export REPLICA_COUNT=1",
            "export NODE_NUMBER=3",
            "until [[ \"$(kubectl ${KCTL}  get nodes | grep -v NAME | grep -w Ready | wc -l)\" -ge \"${NODE_NUMBER}\" ]]",
            "do",
            "  echo -e \"\\nChecking if all the Nodes joined cluster\"",
            "  echo -e \"\\n-------\"",
            "  kubectl get nodes",
            "  sleep 10s",
            "done",
            "echo -e \"\\nNodes joined the cluster. Scaling up replicas\\n\"",
            "kubectl $KCTL scale statefulset/mongodb                     --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale statefulset/group1-redis                --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale statefulset/comp-redis                  --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/admin-dashboard              --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-attr                  --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-handler               --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-crpt                  --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-g_app                 --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-ft-work               --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-thermal               --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-thermal-work          --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-proc                  --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-library               --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-finder                --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-sync-r-12             --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-sync-r-4              --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-sync-r-7              --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-sync-r-8              --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-sync-r-9              --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-finder                --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-collater              --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-quick-post            --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-p-ctrl                --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-p-work                --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1-ar                    --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/group1verify                 --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/aliner                       --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/engine                       --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/beanstalk                    --replicas=$REPLICA_COUNT -n dfg",
            "kubectl $KCTL scale deployment/floppy                       --replicas=$REPLICA_COUNT -n dfg",
