pipeline {
    agent { label 'devops' }
    options {
        timestamps ()
        timeout(time: 30, unit: 'MINUTES')
    }
    triggers {
        cron('0 23 * * * ')
    }
    stages {
		stage('scale down replicas') {
            steps {
                dir('jenkins') {
                    sh ('''#!/bin/bash
                        set +v					
                        bash ../scripts/ssm-send-command.sh i-0661d7f3cd0e50433 ./staging/scailing/ssm-scale-down.json
                    ''')
                }
            }
        }
        stage('K8S-Nodes-Stop') {
            steps {
                sh ('''#!/bin/bash
                    set +v
                    curl --silent --location "https://github.com/weaveworks/eksctl/releases/latest/download/eksctl_$(uname -s)_amd64.tar.gz" | tar xz -C /tmp
                    sudo mv /tmp/eksctl /usr/local/bin
                    eksctl scale nodegroup --cluster comp-tf-stage --region eu-west-1 --name on-demand-1234 --nodes 0 --nodes-min=0 --nodes-max=1
                    eksctl scale nodegroup --cluster comp-tf-stage --region eu-west-1 --name r52xlarge --nodes 0 --nodes-min=0 --nodes-max=1
                ''')
            }
        }
        stage('y_app-RDS-Stop') {
            steps {
                sh "aws rds stop-db-instance --db-instance-identifier stagingmysql-y_app --region eu-west-1"
            }
        }
        stage('phbot-RDS-Stop') {
            steps {
                sh "aws rds stop-db-instance --db-instance-identifier phbot-mysql-staging --region eu-west-1"
            }
        }
        stage('Bastion-host-Stop') {
            steps {
                sh "aws ec2 stop-instances --instance-ids i-1234 --region eu-west-1"
            }
        }
    }
}